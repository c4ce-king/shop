# ---------- BACKEND (Laravel) ----------
backend/vendor/
backend/node_modules/

# ignore runtime cache/storage entirely (but keep folder via nested .gitignore)
backend/bootstrap/cache/**
!backend/bootstrap/cache/.gitignore

backend/storage/**
!backend/storage/.gitignore

backend/.env
backend/*.log

# ---------- FRONTEND (Next.js) ----------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/.vercel/
frontend/.eslintcache
frontend/*.log

# ---------- ENV ----------
.env
.env.*
frontend/.env.local
frontend/.env.*

# ---------- ZIP / dumps ----------
*.zip
shop.zip
